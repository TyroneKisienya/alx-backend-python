#!/bin/bash

echo "🚀 Starting Rolling Update to version 2.0..."

echo "📦 Applying updated deployment (blue_deployment.yaml)..."
kubectl apply -f blue_deployment.yaml

echo "⏳ Monitoring rollout status..."
kubectl rollout status deployment/django-blue

echo "✅ Rollout completed successfully!"
echo ""

echo "🧪 Starting downtime test (continuous curl requests)..."
echo "Press CTRL+C to stop."

SERVICE_IP=$(minikube ip)
URL="http://$SERVICE_IP:8000/api/"

(
  while true; do
    RESPONSE=$(curl -s -o /dev/null -w "%{http_code}" $URL)
    echo "Response: $RESPONSE"
    sleep 0.5
  done
) &

CURL_PID=$!

echo "📊 Showing updated pods:"
kubectl get pods -l version=blue -o wide

echo ""
echo "🛑 To stop curl testing, run: kill $CURL_PID"
